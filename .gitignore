# --- Generated output (always reproducible by re-running the tools) ---
output/*
!output/.gitkeep

# --- think-cell's automation template ---
# Copied from the user's own licensed think-cell install on first use.
# Not redistributed with this project.
templates/*.pptx
!templates/.gitkeep
# chart library cut from the install, and the user's own slide templates
templates/library/
templates/user/

# --- Local / personal files (not part of the published project) ---
template.pptx
*.ppttc
~$*
.mcp.json
agents aztec.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# autoresearch experiment log (local only)
results.tsv
eval.log

# --- Remote connector secret (server.py --http) ---
.connector_token
*.local.bat
dist/
